<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      MK BOARD GAMES does not show ads, use the Advertising ID, query installed
      packages, or install packages from within the app. These permissions
      are explicitly stripped from the merged manifest in case any library
      (present now or added later) tries to pull them in transitively, so
      the Play Console policy declarations for these permissions stay
      accurate.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application
        android:name=".MKBoardGamesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.MKBoardGames"
        android:supportsRtl="true"
        android:resizeableActivity="true">

        <!--
          Activities used to be locked to android:screenOrientation="portrait",
          which Google Play flags as a large-screen/resizability restriction:
          tablets, foldables and Chrome OS devices are often held in landscape,
          and a hard portrait lock forces letterboxing or blocks the app
          outright on those form factors. Every board view already centers a
          square board using the smaller of width/height (see BoardView,
          MorabarabaBoardView, TicTacToeActivity's board), so they
          already render correctly at any aspect ratio — only the manifest lock
          needed to change. "unspecified" lets the system pick the natural
          orientation per device (typically portrait on phones, landscape on
          many tablets) while still rotating with the sensor/tilt; the existing
          configChanges keeps activities from restarting (and losing game
          state) across that rotation.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ReplayActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".MorabarabaActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".TicTacToeActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ConnectFourActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".LudoActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".MancalaActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".YoteActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <activity
            android:name=".OnitamaActivity"
            android:exported="false"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize" />

        <!-- Xiangqi uses the shared game and replay activities. -->

    </application>

</manifest>
